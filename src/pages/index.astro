---
import BaseLayout from "../layouts/BaseLayout.astro";
import OpticalField from "../components/OpticalField.astro";
import { profile } from "../data/profile";
import { researchStories } from "../data/research";
import { photos } from "../data/photos";
import { withBase } from "../utils/paths";

const previewItems = ["City", "Nature", "Humanities"]
  .map((series) => photos.find((photo) => photo.series === series))
  .filter((photo): photo is (typeof photos)[number] => Boolean(photo))
  .map((photo, index) => ({
      src: photo.variants.at(-1)?.src ?? photo.variants[0]?.src ?? "",
      alt: photo.alt,
      width: photo.width,
      height: photo.height,
      label: `${String(index + 1).padStart(2, "0")} · ${photo.title}`,
      badge: photo.seriesZh || photo.series,
    }));
---

<BaseLayout
  title="Yingjie Shi / 师瑛杰 — Light, Computation, Observation"
  description="The personal research and photography archive of Yingjie Shi, a postdoctoral researcher in computational imaging at Nanjing University of Science and Technology."
>
  <section class="home-hero shell">
    <div class="hero-copy reveal">
      <p class="hero-no">N° 32.04′ · Nanjing · 2026</p>
      <p class="eyebrow"><span data-en>Researcher of light</span><span data-zh>一个研究光的人</span></p>
      <h1>Yingjie <em>Shi</em></h1>
      <p class="hero-cn">师 瑛 杰</p>
      <p class="hero-lede">
        <span data-en>{profile.statement} With light, recording what remains visible—and what does not.</span>
        <span data-zh>{profile.statementZh}也用光记录仍然可见、以及不可直接看见的世界。</span>
      </p>
      <div class="hero-meta">
        <span><span data-en>{profile.role}</span><span data-zh>{profile.roleZh}</span></span>
        <span><span data-en>{profile.institution}</span><span data-zh>{profile.institutionZh}</span></span>
      </div>
      <a class="hero-scroll" href="#selected-work"><span data-en>Enter the archive</span><span data-zh>进入档案</span><i></i></a>
    </div>
    <OpticalField />
  </section>

  <div class="marquee-line" aria-hidden="true">
    <div class="marquee-track">
      <span>Light transport · Scattering · Transients · Memory · Perception · Photography · 光传输 · 散射 · 瞬态 · 记忆 · 感知 · 摄影</span>
      <span>Light transport · Scattering · Transients · Memory · Perception · Photography · 光传输 · 散射 · 瞬态 · 记忆 · 感知 · 摄影</span>
    </div>
  </div>

  <section class="section shell" id="selected-work">
    <div class="section-heading reveal">
      <span class="section-no">01 — 02</span>
      <h2><span data-en>Selected research</span><span data-zh>代表性研究</span></h2>
      <p><span data-en>Selected publications, interpreted through the questions they ask of light.</span><span data-zh>从光所回答的问题出发，呈现代表性研究成果。</span></p>
    </div>
    <div class="research-grid">
      {researchStories.map((story, index) => (
        <a class="research-row reveal" href={withBase(`/research/${story.slug}/`)}>
          <span class="research-index">0{index + 1}</span>
          <h3><span data-en>{story.title}</span><span data-zh>{story.titleZh}</span></h3>
          <p class="research-description"><span data-en>{story.description}</span><span data-zh>{story.descriptionZh}</span></p>
          <span class="research-arrow" aria-hidden="true">↗</span>
          <span class="research-year">{story.year}</span>
        </a>
      ))}
    </div>
    <p style="margin-top:32px"><a class="text-link" href={withBase("/research/")}><span data-en>All research areas</span><span data-zh>查看全部研究方向</span></a></p>
  </section>

  <section class="section dark-section">
    <div class="shell">
      <div class="section-heading reveal">
        <span class="section-no">02 — 02</span>
        <h2><span data-en>Photography archive</span><span data-zh>个人摄影集</span></h2>
        <p><span data-en>Light, space, and fragments of everyday life.</span><span data-zh>光线、空间与日常生活的片段。</span></p>
      </div>
      <div class="photo-preview reveal" aria-label="Selected photographs">
        {previewItems.map((item) => (
          <figure class="photo-study"><img src={withBase(item.src)} width={item.width} height={item.height} alt={item.alt} loading="lazy" /><figcaption><span>{item.label}</span><span>{item.badge}</span></figcaption></figure>
        ))}
      </div>
      <p style="margin-top:38px"><a class="text-link" href={withBase("/photography/")}><span data-en>Open the photography archive</span><span data-zh>查看个人摄影集</span></a></p>
    </div>
  </section>
</BaseLayout>
