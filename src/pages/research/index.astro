---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import { researchAreas, researchStories } from "../../data/research";
import { withBase } from "../../utils/paths";
---

<BaseLayout title="Research — Yingjie Shi" description="Research interests and selected work by Yingjie Shi in computational imaging, NLOS imaging, scattering media, and time-resolved imaging.">
  <PageIntro index="01" title="Research" titleZh="科研" description="Questions of visibility, encoded in time, polarization, scattering, and computation." descriptionZh="关于可见性的研究：把答案编码在时间、偏振、散射与计算之中。" />
  <section class="area-list shell" aria-label="Research areas">
    {researchAreas.map((area) => (
      <article class="area-item reveal">
        <span class="research-index">{area.index}</span>
        <h2><span data-en>{area.title}</span><span data-zh>{area.titleZh}</span></h2>
        <p><span data-en>{area.description}</span><span data-zh>{area.descriptionZh}</span></p>
        <span class="area-signal">{area.signal}</span>
      </article>
    ))}
  </section>
  <section class="dark-section">
    <div class="story-list shell">
      <p class="eyebrow"><span data-en>Research stories</span><span data-zh>研究故事</span></p>
      {researchStories.map((story) => (
        <article class="story-card reveal">
          <span class="story-year">{story.year}</span>
          <div>
            <p class="eyebrow"><span data-en>{story.kicker}</span><span data-zh>{story.kickerZh}</span></p>
            <h2><span data-en>{story.title}</span><span data-zh>{story.titleZh}</span></h2>
          </div>
          <div class="story-side">
            <p><span data-en>{story.description}</span><span data-zh>{story.descriptionZh}</span></p>
            <a class="text-link" href={withBase(`/research/${story.slug}/`)}><span data-en>Read the research note</span><span data-zh>阅读研究说明</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
