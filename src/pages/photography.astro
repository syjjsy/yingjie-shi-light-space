---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import { photos } from "../data/photos";
import { withMediaBase } from "../utils/paths";

const categoryDefinitions = [
  { key: "City", title: "City", titleZh: "城市" },
  { key: "Nature", title: "Nature", titleZh: "自然" },
  { key: "Humanities", title: "Humanities", titleZh: "人文" },
];
const categories = categoryDefinitions.map((category) => ({
  ...category,
  photos: photos.filter((photo) => photo.series === category.key),
})).filter((category) => category.photos.length);
const globalIndex = new Map(photos.map((photo, index) => [photo.source, index]));
---

<BaseLayout title="Photography — Yingjie Shi" description="Photography by Yingjie Shi.">
  <PageIntro index="03" title="Photography" titleZh="摄影" description="Light, space, and fragments of everyday life." descriptionZh="光线、空间与日常生活的片段。" />
  <div class="photo-categories shell" aria-label="Photography archive">
    {categories.map((category, categoryIndex) => (
      <section class="photo-category" data-photo-category={category.key.toLowerCase()} aria-labelledby={`photo-category-${category.key.toLowerCase()}`}>
        <header class="photo-category-header reveal">
          <span class="photo-category-index">0{categoryIndex + 1}</span>
          <h2 id={`photo-category-${category.key.toLowerCase()}`}><span data-en>{category.title}</span><span data-zh>{category.titleZh}</span></h2>
          <p>{category.photos.length} <span data-en>photographs</span><span data-zh>张照片</span></p>
        </header>
        <div class="photo-category-grid">
          {category.photos.map((photo, index) => {
            const full = photo.variants.at(-1)?.src ?? photo.variants[0]?.src ?? "";
            const preview = photo.variants.find((variant) => variant.width >= 1280)?.src ?? full;
            const title = photo.caption ? `${photo.title} — ${photo.caption}` : photo.title;
            const order = globalIndex.get(photo.source) ?? 0;
            return (
              <figure
                class="gallery-demo-card reveal"
                data-gallery-item
                data-full={withMediaBase(full)}
                data-alt={photo.alt}
                data-title={title}
                role="button"
                tabindex="0"
                aria-label={`${category.titleZh} · ${photo.titleZh || photo.title}`}
              >
                <div class="gallery-image-frame">
                  <img
                    src={withMediaBase(preview)}
                    srcset={photo.variants.map((variant) => `${withMediaBase(variant.src)} ${variant.width}w`).join(", ")}
                    sizes="(max-width: 620px) 100vw, (max-width: 980px) 50vw, 33vw"
                    width={photo.width}
                    height={photo.height}
                    alt={photo.alt}
                    loading={order < 2 ? "eager" : "lazy"}
                  />
                </div>
                <figcaption>
                  <span>{String(index + 1).padStart(2, "0")} · <span data-en>{photo.title}</span><span data-zh>{photo.titleZh || photo.title}</span></span>
                  {photo.date && <span class="demo-badge">{photo.date}</span>}
                </figcaption>
              </figure>
            );
          })}
        </div>
      </section>
    ))}
  </div>
  <dialog class="lightbox" data-lightbox aria-label="Image viewer">
    <div class="lightbox-inner">
      <button class="lightbox-close" type="button" data-lightbox-close aria-label="Close">Close ×</button>
      <button class="lightbox-prev" type="button" data-lightbox-prev aria-label="Previous image">←</button>
      <img alt="" />
      <button class="lightbox-next" type="button" data-lightbox-next aria-label="Next image">→</button>
      <p class="lightbox-title" data-lightbox-title></p>
    </div>
  </dialog>
</BaseLayout>
