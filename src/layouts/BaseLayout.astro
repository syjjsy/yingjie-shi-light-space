---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { withBase, withMediaBase } from "../utils/paths";

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  image = "/og.svg",
  article = false,
  bodyClass,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(withMediaBase(image), Astro.site);
---

<!doctype html>
<html lang="en" data-language="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eee9df" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withMediaBase("/favicon.svg")} type="image/svg+xml" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        document.documentElement.classList.add("js");
        let saved = null;
        try { saved = localStorage.getItem("language"); } catch {}
        const preferred = saved || (navigator.language.startsWith("zh") ? "zh" : "en");
        document.documentElement.dataset.language = preferred;
        document.documentElement.lang = preferred === "zh" ? "zh-CN" : "en";
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#content"><span data-en>Skip to content</span><span data-zh>跳至正文</span></a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <div class="grain" aria-hidden="true"></div>
    <script src={withBase("/site.js")} defer></script>
  </body>
</html>
